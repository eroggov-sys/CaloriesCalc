@api = http://localhost:5077
@email = test@example.com
@password = Test123!
@date = 2026-09-10

### register
POST {{api}}/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Enter
# @name login
POST {{api}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###
@token = {{login.response.body.$.accessToken}}

### profile
GET {{api}}/api/profile
Authorization: Bearer {{token}}

### targets
GET {{api}}/api/profile/targets
Authorization: Bearer {{token}}

### search products
GET {{api}}/api/Food/search?query=milk
Authorization: Bearer {{token}}

### day result
GET {{api}}/api/FoodEntries/daily?date={{date}}
Authorization: Bearer {{token}}

### Daily records of meals
GET {{api}}/api/FoodEntries/by-date?date={{date}}
Authorization: Bearer {{token}}

### Add an entry (1 — product ID from the search)
POST {{api}}/api/FoodEntries/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantityGrams": 150,
  "eatenAt": "{{date}}T12:00:00Z",
  "mealType": "Breakfast"
}

### OpenAPI-doc
GET {{api}}/openapi/v1.json
